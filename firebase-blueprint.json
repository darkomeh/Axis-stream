{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "isBanned": { "type": "boolean" },
         "role": { "type": "string", "enum": ["user", "admin", "moderator"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "User support message or bug report",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed", "replied"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastUpdate": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "subject", "message", "createdAt"]
    },
    "SupportReply": {
      "title": "SupportReply",
      "description": "Admin reply to a support ticket",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adminId", "text", "createdAt"]
    },
    "GlobalStats": {
      "title": "GlobalStats",
      "description": "Aggregated application analytics",
      "type": "object",
      "properties": {
        "totalVisitors": { "type": "number" },
        "totalWatchTimeSeconds": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    },
    "WatchHistory": {
      "title": "WatchHistory",
      "description": "User's watch history entry",
      "type": "object",
      "properties": {
        "movieId": { "type": "string" },
        "title": { "type": "string" },
        "watchedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["movieId", "watchedAt"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "User's favorite movie",
      "type": "object",
      "properties": {
        "movieId": { "type": "string" },
        "title": { "type": "string" },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["movieId", "addedAt"]
    },
    "ContinueWatching": {
      "title": "ContinueWatching",
      "description": "Progress tracking for media",
      "type": "object",
      "properties": {
        "movieId": { "type": "string" },
        "title": { "type": "string" },
        "lastPosition": { "type": "number" },
        "duration": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["movieId", "lastPosition"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Global or group chat message",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "userId", "createdAt"]
    },
    "PlatformError": {
      "title": "PlatformError",
      "description": "Automatically logged system exception",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "stack": { "type": "string" },
        "componentName": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "url": { "type": "string" },
        "userAgent": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "resolved": { "type": "boolean" },
        "resolvedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["message", "timestamp"]
    },
    "Report": {
      "title": "Report",
      "description": "User report for content or issues",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "category": { "type": "string" },
        "detail": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "category", "detail", "status", "createdAt"]
    },
    "WatchParty": {
      "title": "WatchParty",
      "description": "Watch party room",
      "type": "object",
      "properties": {
        "hostId": { "type": "string" },
        "mediaId": { "type": "string" },
        "mediaType": { "type": "string" },
        "mediaTitle": { "type": "string" },
        "posterUrl": { "type": "string" },
        "playbackState": { "type": "object" },
        "createdAt": { "type": "number" }
      },
      "required": ["hostId", "mediaId", "playbackState", "createdAt"]
    },
    "PartyParticipant": {
      "title": "PartyParticipant",
      "description": "Watch party participant",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "joinedAt": { "type": "number" }
      },
      "required": ["uid", "displayName", "isOnline", "joinedAt"]
    },
    "PartyMessage": {
      "title": "PartyMessage",
      "description": "Watch party chat message",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "displayName", "text", "createdAt"]
    },
    "SportsPoll": {
      "title": "SportsPoll",
      "description": "Poll results for a sports match",
      "type": "object",
      "properties": {
        "home": { "type": "number" },
        "draw": { "type": "number" },
        "away": { "type": "number" }
      },
      "required": ["home", "draw", "away"]
    },
    "SportsChatMessage": {
      "title": "SportsChatMessage",
      "description": "Live chat message for a sports match",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "uid", "displayName", "timestamp"]
    },
    "SportsViewerSession": {
      "title": "SportsViewerSession",
      "description": "Active live stream viewer session",
      "type": "object",
      "properties": {
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["joinedAt"]
    }
  },
  "firestore": {
    "watchParties/{partyId}": {
      "schema": "WatchParty",
      "description": "Active watch party rooms"
    },
    "watchParties/{partyId}/participants/{participantId}": {
      "schema": "PartyParticipant",
      "description": "Watch party participants"
    },
    "watchParties/{partyId}/messages/{messageId}": {
      "schema": "PartyMessage",
      "description": "Watch party live chat messages"
    },
    "users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles"
    },
    "users/{userId}/watchHistory/{historyId}": {
      "schema": "WatchHistory",
      "description": "User's watch history"
    },
    "users/{userId}/favorites/{favoriteId}": {
      "schema": "Favorite",
      "description": "User's favorite movies"
    },
    "users/{userId}/continueWatching/{movieId}": {
      "schema": "ContinueWatching",
      "description": "Media progress tracking"
    },
    "globalChat/{messageId}": {
      "schema": "ChatMessage",
      "description": "Global chat messages"
    },
    "supportTickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "User support tickets"
    },
    "supportTickets/{ticketId}/replies/{replyId}": {
      "schema": "SupportReply",
      "description": "Admin replies to tickets"
    },
    "analytics/global": {
      "schema": "GlobalStats",
      "description": "Global aggregated stats"
    },
    "liveStats/viewers": {
      "schema": "object",
      "description": "Real-time viewer counts"
    },
    "platform_errors/{errorId}": {
      "schema": "PlatformError",
      "description": "System error logs"
    },
    "reports/{reportId}": {
      "schema": "Report",
      "description": "User reports"
    },
    "sports_polls/{matchId}": {
      "schema": "SportsPoll",
      "description": "Match winner voting poll results"
    },
    "sports_chat/{matchId}/messages/{messageId}": {
      "schema": "SportsChatMessage",
      "description": "Live match specific chat messages"
    },
    "sports_viewers/{matchId}/active/{userId}": {
      "schema": "SportsViewerSession",
      "description": "Active viewer presence for a live sports match"
    }
  }
}
