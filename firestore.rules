rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Auth tokens don't have custom claims, so we check a specific 'admins' collection or hardcode for bootstrap if safe.
    // User email from runtime: greatmayuku2@gmail.com
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'greatmayuku2@gmail.com' && request.auth.token.email_verified == true
      ); 
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'photoURL', 'createdAt', 'lastLogin']) &&
             data.keys().size() == 6 &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.name is string && data.name.size() <= 128 &&
             data.photoURL is string && data.photoURL.size() <= 1024 &&
             data.createdAt == request.time &&
             data.lastLogin == request.time;
    }

    function isValidWatchHistory(data) {
      return data.keys().hasAll(['movieId', 'title', 'watchedAt']) &&
             data.keys().size() == 3 &&
             data.movieId is string && data.movieId.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.watchedAt == request.time;
    }

    function isValidFavorite(data) {
      return data.keys().hasAll(['movieId', 'title', 'addedAt']) &&
             data.keys().size() == 3 &&
             data.movieId is string && data.movieId.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.addedAt == request.time;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && isValidUser(incoming());
      
      allow update: if isOwner(userId) && (
        // Action: Update lastLogin
        (incoming().diff(existing()).affectedKeys().hasOnly(['lastLogin']) && incoming().lastLogin == request.time)
      );

      match /watchHistory/{historyId} {
        allow list: if isOwner(userId) || isAdmin();
        allow get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidWatchHistory(incoming());
        // No updates for history entries as per usual streaming app logic, they are immutable records
        allow delete: if isOwner(userId);
      }

      match /favorites/{favoriteId} {
        allow list: if isOwner(userId) || isAdmin();
        allow get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidFavorite(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
