rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'greatmayuku2@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      ); 
    }

    // --- Validation Blueprints ---
    function isValidWatchHistory(data) {
      return data.keys().hasAll(['movieId', 'title', 'watchedAt']) &&
             data.keys().size() == 3 &&
             data.movieId is string && data.movieId.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.watchedAt == request.time;
    }

    function isValidFavorite(data) {
      return data.keys().hasAll(['movieId', 'title', 'addedAt']) &&
             data.movieId is string && data.movieId.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.addedAt == request.time;
    }
    function isValidUser(data) {
      // Simplified validation to prevent "Missing or insufficient permissions" for valid users
      let requiredFields = ['uid', 'email', 'name', 'photoURL', 'createdAt', 'lastLogin', 'role', 'isBanned', 'securityInfo'];
      return data.keys().hasAll(requiredFields) &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.name is string &&
             data.createdAt == request.time &&
             data.lastLogin == request.time;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['text', 'userId', 'userName', 'createdAt']) &&
             data.text is string && data.text.size() <= 500 &&
             data.userId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidContinueWatching(data) {
      return data.keys().hasAll(['movieId', 'title', 'lastPosition', 'updatedAt']) &&
             data.movieId is string &&
             data.updatedAt == request.time;
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll(['userId', 'userName', 'userEmail', 'subject', 'message', 'status', 'createdAt', 'lastUpdate']) &&
             data.userId == request.auth.uid &&
             data.status == 'open' &&
             data.createdAt == request.time &&
             data.lastUpdate == request.time;
    }

    function isValidSupportReply(data) {
      return data.keys().hasAll(['adminId', 'text', 'createdAt']) &&
             isAdmin() &&
             data.adminId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidPlatformError(data) {
      return data.keys().hasAll(['message', 'timestamp', 'url', 'userAgent', 'resolved']) &&
             data.message is string && data.message.size() <= 2000 &&
             data.timestamp == request.time &&
             data.resolved == false;
    }
    
    function isValidReport(data) {
      return data.keys().hasAll(['userId', 'category', 'detail', 'status', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.category is string &&
             data.detail is string &&
             data.status == 'open' &&
             data.createdAt == request.time;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && isValidUser(incoming());
      
      allow update: if isOwner(userId) && (
        // Action: Update profile info or Heartbeat
        incoming().lastLogin == request.time
      ) || isAdmin();

      match /continueWatching/{movieId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidContinueWatching(incoming());
      }

      match /watchHistory/{historyId} {
        allow list: if isOwner(userId) || isAdmin();
        allow get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidWatchHistory(incoming());
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /favorites/{favoriteId} {
        allow list: if isOwner(userId) || isAdmin();
        allow get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidFavorite(incoming());
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /globalChat/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidChatMessage(incoming());
      allow delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidSupportTicket(incoming());
      allow update: if isAdmin();

      match /replies/{replyId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid || isAdmin());
        allow create: if isAdmin() && isValidSupportReply(incoming());
      }
    }

    match /analytics/global {
      allow read: if true;
      allow update: if true;
      allow create: if true;
    }

    match /admin/config {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /liveStats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /platform_errors/{errorId} {
      allow list: if isAdmin();
      allow get: if isAdmin();
      allow create: if true && isValidPlatformError(incoming());
      allow update: if isAdmin();
    }

    match /reports/{reportId} {
      allow list: if isAdmin();
      allow get: if isAdmin();
      allow create: if isSignedIn() && isValidReport(incoming());
      allow update: if isAdmin();
    }
  }
}
