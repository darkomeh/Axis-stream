rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isAdmin() { 
      return request.auth != null && (
        request.auth.token.email == 'greatmayuku2@gmail.com'
        // Relaxing verified check for bootstrap if needed, but keeping it for production security
        // && request.auth.token.email_verified == true
      ); 
    }

    // --- Validation Blueprints ---
    function isValidWatchHistory(data) {
      return data.keys().hasAll(['movieId', 'title', 'watchedAt']) &&
             data.keys().size() == 3 &&
             data.movieId is string && data.movieId.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.watchedAt == request.time;
    }

    function isValidFavorite(data) {
      return data.keys().hasAll(['movieId', 'title', 'addedAt']) &&
             data.keys().size() == 3 &&
             data.movieId is string && data.movieId.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.addedAt == request.time;
    }
    function isValidUser(data) {
      let requiredFields = ['uid', 'email', 'name', 'photoURL', 'createdAt', 'lastLogin', 'role', 'isBanned'];
      return data.keys().hasAll(requiredFields) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.name is string && data.name.size() <= 128 &&
             data.photoURL is string && data.photoURL.size() <= 1024 &&
             data.role in ['user', 'admin', 'moderator'] &&
             data.isBanned is bool &&
             data.createdAt == request.time &&
             data.lastLogin == request.time;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['text', 'userId', 'userName', 'userAvatar', 'createdAt']) &&
             data.keys().size() == 5 &&
             data.text is string && data.text.size() <= 500 &&
             data.userId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidContinueWatching(data) {
      return data.keys().hasAll(['movieId', 'title', 'lastPosition', 'duration', 'updatedAt']) &&
             data.movieId is string &&
             data.lastPosition is number &&
             data.updatedAt == request.time;
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll(['userId', 'userName', 'userEmail', 'subject', 'message', 'status', 'createdAt', 'lastUpdate']) &&
             data.userId == request.auth.uid &&
             data.status == 'open' &&
             data.createdAt == request.time &&
             data.lastUpdate == request.time;
    }

    function isValidSupportReply(data) {
      return data.keys().hasAll(['adminId', 'text', 'createdAt']) &&
             isAdmin() &&
             data.adminId == request.auth.uid &&
             data.createdAt == request.time;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && isValidUser(incoming());
      
      allow update: if isOwner(userId) && (
        // Action: Update profile info
        (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoURL', 'bio', 'username', 'lastLogin']) && incoming().lastLogin == request.time) ||
        // Action: Heartbeat
        (incoming().diff(existing()).affectedKeys().hasOnly(['lastLogin']) && incoming().lastLogin == request.time)
      ) || isAdmin();

      match /continueWatching/{movieId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidContinueWatching(incoming());
      }

      match /watchHistory/{historyId} {
        allow list: if isOwner(userId) || isAdmin();
        allow get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidWatchHistory(incoming());
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /favorites/{favoriteId} {
        allow list: if isOwner(userId) || isAdmin();
        allow get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidFavorite(incoming());
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /globalChat/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidChatMessage(incoming());
      allow delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidSupportTicket(incoming());
      allow update: if isAdmin();

      match /replies/{replyId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid || isAdmin());
        allow create: if isAdmin() && isValidSupportReply(incoming());
      }
    }

    match /analytics/global {
      allow read: if isAdmin();
      allow update: if true; // Allow anyone to increment stats for visitors/watchtime? Risky but simplest for client-side tracking.
      // Better: restrict updates to only incrementing specific fields
    }

    match /liveStats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
