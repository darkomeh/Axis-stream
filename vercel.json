{
  "rewrites": [
    {
      "source": "/api/aggregated-popular",
      "destination": "/api/aggregated-popular"
    },
    {
      "source": "/api/proxy",
      "destination": "/api/proxy"
    },
    {
      "source": "/api/image-proxy",
      "destination": "/api/image-proxy"
    },
    {
      "source": "/api/:path*",
      "destination": "https://movieapi.xcasper.space/api/:path*?apikey=Godszeal"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
